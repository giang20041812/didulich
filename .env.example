# Danh sách đầy đủ biến môi trường của backend (Supabase/Vercel, CRON_SECRET, RESEND_API_KEY, CORS_ALLOWED_ORIGIN_PATTERNS...)
# nằm ở backend-api/.env.example. File này chỉ là cấu hình tối thiểu (PostgreSQL).

# ============================================================
# DATABASE CONFIGURATION
# ============================================================
DB_URL=jdbc:postgresql://localhost:5432/viettrek
DB_USERNAME=postgres
DB_PASSWORD=change_me

# ============================================================
# GMAIL SMTP CONFIGURATION
# ============================================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password_here

# ============================================================
# APPLICATION CONFIGURATION
# ============================================================
SERVER_PORT=8080
# Chuỗi ngẫu nhiên >= 32 ký tự (openssl rand -base64 48); bắt buộc trên profile prod/supabase.
JWT_SECRET=your_jwt_secret_key_at_least_32_chars_long
